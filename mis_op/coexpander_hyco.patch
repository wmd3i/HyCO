index 0000000..0fa4f6c
--- /dev/null
+++ b/co_expander/env/sparse/op.py
@@ -0,0 +1,136 @@
+# co_expander_edit/env/sparse/op.py
+
+import torch
+import numpy as np
+from torch import Tensor
+from typing import Sequence, List, Dict, Tuple, Any
+from sklearn.neighbors import KDTree
+from ml4co_kit import check_dim, to_tensor
+import re
+
+# --- OP data parsing functions (adapted from data_loader_sparse.py) ---
+def parse_op_line(line: str) -> Tuple[np.ndarray, np.ndarray, float, List[int]]:
+    """Parses a single line of the OP text file."""
+    parts = line.strip().split(';')
+    data = {}
+    for part in parts:
+        if ':' in part:
+            key, value = part.split(':', 1)
+            data[key.strip()] = value.strip()
+
+    depot_coords = [float(x) for x in data['depots'].split()]
+    customer_coords_flat = [float(x) for x in data['points'].split()]
+    customer_coords = np.array(customer_coords_flat).reshape(-1, 2).tolist()
+    all_coords = np.array([depot_coords] + customer_coords, dtype=np.float32)
+    prizes = [0.0] + [float(x) for x in data['prizes'].split()]
+    prizes = np.array(prizes, dtype=np.float32)
+    max_length = float(data['max_length'])
+    tour = [int(x) for x in data['output'].split()]
+
+    return all_coords, prizes, max_length, tour
+
+# --- OP sparse processing function ---
+def op_sparse_process(
+    op_instance_data: Tuple[np.ndarray, np.ndarray, float, List[int]], # coords, prizes, max_length, tour
+    sparse_factor: int,
+    prefix_k_options: list = None # Accept prefix options
+) -> Sequence[Tensor | List | int | Any]:
+    """Processes a single OP instance for sparse GNN with prefix conditioning."""
+    coords, prizes, max_length, ref_tour = op_instance_data
+
+    nodes_num = coords.shape[0]
+    if nodes_num <= sparse_factor:
+        raise ValueError("sparse_factor must be smaller than nodes_num for k-NN graph.")
+
+    # 1. Build the k-NN graph (same as in data_loader_sparse.py)
+    kdt = KDTree(coords, metric='euclidean')
+    _, knn_indices = kdt.query(coords, k=sparse_factor)
+
+    source_nodes = torch.arange(nodes_num).view(-1, 1).repeat(1, sparse_factor).flatten()
+    target_nodes = torch.from_numpy(knn_indices).flatten()
+
+    edge_index = torch.stack([source_nodes, target_nodes], dim=0)
+    # Make undirected, remove self-loops and duplicates
+    edge_index = torch.cat([edge_index, edge_index.flip(0)], dim=1)
+    edge_index = edge_index[:, edge_index[0] != edge_index[1]]
+    edge_index_sorted, _ = torch.sort(edge_index, dim=0)
+    edge_index = torch.unique(edge_index_sorted, dim=1)
+    edges_num = edge_index.shape[1]
+
+    # 2. Edge features (normalized distances)
+    src, dst = edge_index[0], edge_index[1]
+    distances = torch.linalg.norm(to_tensor(coords)[src] - to_tensor(coords)[dst], dim=-1)
+    min_dist, max_dist = distances.min(), distances.max()
+    epsilon = 1e-8
+    normalized_distances = (distances - min_dist) / (max_dist - min_dist + epsilon)
+    edges_feature = normalized_distances.unsqueeze(-1).float() # (E, 1)
+
+    # 3. Node features (IsDepot, Prize, IsPrefix)
+    is_depot_feature = torch.zeros((nodes_num, 1), dtype=torch.float32)
+    is_depot_feature[0] = 1.0
+    prize_feature = to_tensor(prizes).unsqueeze(-1).float()
+    node_base_features = torch.cat([is_depot_feature, prize_feature], dim=-1) # (V, 2)
+
+    # 4. Generate prefix information
+    prefix_nodes = torch.tensor([], dtype=torch.long)
+    node_prefix_state = torch.zeros((nodes_num, 1), dtype=torch.float32) # (V, 1)
+# --- THIS IS THE FIX ---
+    # Convert ref_tour list to a torch tensor using torch.tensor
+    ref_tour_tensor = torch.tensor(ref_tour, dtype=torch.long)
+    # --- END FIX ---
+    
+    actual_tour_len = len(ref_tour) # Length of the reference solution
+
+    if prefix_k_options is not None and len(prefix_k_options) > 0:
+        # Filter k options to be valid for this tour length
+        # OP prefix is a segment of the *solution* tour, k < actual_tour_len
+        valid_k_options = [k for k in prefix_k_options if k < actual_tour_len]
+
+        if not valid_k_options:
+            prefix_k = 0 # Default to depot only if tour is too short
+        else:
+            prefix_k = int(np.random.choice(valid_k_options))
+
+        if prefix_k > 0:
+            # Simple strategy: take the first k nodes from the reference tour
+            prefix_nodes = ref_tour_tensor[:prefix_k]
+            node_prefix_state[prefix_nodes] = 1.0
+
+    # Assemble the final node features (including IsPrefix)
+    nodes_feature_final = torch.cat([node_base_features, node_prefix_state], dim=-1).float() # (V, 3)
+
+    # 5. Build the ground truth (which edges are in the reference solution)
+    ground_truth = torch.zeros(edges_num, dtype=torch.long)
+    tour_edges_set = set()
+    if actual_tour_len > 1:
+        for i in range(actual_tour_len - 1):
+            u, v = ref_tour[i], ref_tour[i+1]
+            tour_edges_set.add(tuple(sorted((u, v))))
+
+    for i in range(edges_num):
+        u, v = edge_index[0, i].item(), edge_index[1, i].item()
+        if tuple(sorted((u, v))) in tour_edges_set:
+            ground_truth[i] = 1
+
+    # 6. Other variables
+    e = torch.zeros(edges_num) # Edge decision variables (initialized to 0)
+    mask = torch.zeros(edges_num) # Edge mask (initialized to 0)
+    raw_data = (coords, prizes, max_length, ref_tour) # Store original data
+
+    # Return a tuple compatible with sparser.py (14 items, including max_length)
+    return (
+        nodes_feature_final, # [0] (V, 3): nodes' feature [IsDepot, Prize, IsPrefix]
+        None,               # [1] x: nodes' decision variable (None for OP)
+        edges_feature,      # [2] (E, 1): edges' feature [distance]
+        e.float(),          # [3] (E,): edges' decision variable (initially 0)
+        edge_index.long(),  # [4] (2, E): index of edge endpoints
+        None,               # [5] graph: adjacency matrix (None for sparse)
+        mask.bool(),        # [6] (E,): mask (initially False)
+        ground_truth.long(),# [7] (E,): ground truth edge labels
+        nodes_num,          # [8] int: number of nodes
+        edges_num,          # [9] int: number of edges in k-NN graph
+        raw_data,           # [10] original data tuple
+        prefix_nodes.long(),# [11] (k,): prefix node indices
+        node_prefix_state.float(), # [12] (V, 1): IsPrefix indicator
+        torch.tensor(max_length, dtype=torch.float32) # [13] Max Length constraint
+    )
\ No newline at end of file
