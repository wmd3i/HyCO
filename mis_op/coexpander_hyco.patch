@@ -0,0 +1,92 @@
+# co_expander_edit/model/embedder/op.py
+
+from typing import Sequence, Tuple
+import torch
+from torch import Tensor, nn
+from co_expander.model.embedder.base import COExpanderEmbedder
+from co_expander.model.embedder.time import timestep_embedding
+from co_expander.model.embedder.utils import ScalarEmbeddingSine1D
+
+class OPEmbedder(COExpanderEmbedder):
+    def __init__(self, hidden_dim: int, sparse: bool, time_flag: bool):
+        super(OPEmbedder, self).__init__(hidden_dim, sparse, time_flag)
+
+        if not self.sparse:
+            raise NotImplementedError("Dense mode not implemented for OPEmbedder")
+
+        # Node Feature Projection (Input: IsDepot, Prize, IsPrefix -> Dim 3)
+        self.node_feature_proj = nn.Linear(3, hidden_dim)
+
+        # Edge Feature Embeddings (Input: Distance -> Dim 1)
+        self.distance_embed = nn.Sequential(
+            ScalarEmbeddingSine1D(hidden_dim),
+            nn.Linear(hidden_dim, hidden_dim)
+        )
+        # Edge Variable 'e' Embedding (Input: Noisy label -> Dim 1 scalar)
+        self.label_embed = nn.Sequential(
+            ScalarEmbeddingSine1D(hidden_dim),
+            nn.Linear(hidden_dim, hidden_dim)
+        )
+        # Merge edge embeddings
+        self.edge_embed = nn.Linear(hidden_dim, hidden_dim)
+
+        # Mask embedding (applied to edges for OP)
+        self.mask_embed = nn.Embedding(2, hidden_dim)
+
+        # Max Length Embedding
+        # Keep the embedding dimension consistent with prefix cond dim (or configurable)
+        self.max_length_embed_dim = hidden_dim // 4 # Example, make configurable later
+        self.max_length_embed = nn.Sequential(
+            nn.Linear(1, self.max_length_embed_dim),
+            nn.ReLU(),
+            nn.Linear(self.max_length_embed_dim, self.max_length_embed_dim)
+        )
+
+    # sparse_forward modified to match GNNEncoder's expectations and return max_length_emb
+    def sparse_forward(
+        self, nodes_feature: Tensor, x: Tensor, edges_feature: Tensor,
+        e: Tensor, mask: Tensor, t: Tensor,
+        node_prefix_state: Tensor, # Already handled by the base class, written out explicitly
+        max_lengths: Tensor        # New
+    ) -> Tuple[Tensor | None, Tensor | None, Tensor | None, Tensor | None]:
+        """
+        Args:
+            nodes_feature: (V, 3) [IsDepot, Prize, IsPrefix]
+            x: None (node decision variable not used)
+            edges_feature: (E, 1) [Distance]
+            e: (E,) Noisy edge label (scalar)
+            mask: (E,) Edge mask (bool)
+            t: (B,) Time step for each graph in batch (or (1,) if single)
+            node_prefix_state: (V, 1) IsPrefix indicator (already included in nodes_feature)
+            max_lengths: (B,) Max length constraint for each graph
+        Return:
+            x_emb: (V, H) Embedded node features
+            e_emb: (E, H) Embedded edge features + mask + label
+            t_emb: (B, H) or (H) Embedded time
+            max_length_emb: (B, H_max_length) Embedded max length constraint
+        """
+        # Node Embedding
+        x_emb = self.node_feature_proj(nodes_feature) # (V, H)
+
+        # Edge Embedding
+        dist_emb = self.distance_embed(edges_feature.squeeze(-1)) # (E, H)
+        label_emb = self.label_embed(e) # (E, H)
+        e_merged = self.edge_embed(dist_emb + label_emb) # Combine (E, H)
+
+        # Add Edge Mask Embedding
+        mask_emb = self.mask_embed(mask.long()) # (E, H)
+        e_emb = e_merged + mask_emb # (E, H)
+
+        # Time Embedding (Handle potential batch dimension in t)
+        t_emb = None
+        if t is not None and hasattr(self, 'time_embedder'):
+            if t.ndim == 0: # If t is scalar, unsqueeze
+                 t = t.unsqueeze(0)
+            # Ensure t has shape (B,) or (1,) before embedding
+            t_processed = timestep_embedding(t.repeat(max_lengths.size(0) if t.size(0)==1 else 1), self.hidden_dim) # Ensure time dim matches batch size
+            t_emb = self.time_embedder(t_processed) # (B, H) or (1, H) -> need (B,H) for layer injection
+
+        # Max Length Embedding
+        max_length_emb = self.max_length_embed(max_lengths.unsqueeze(-1).float()) # (B, H_max_length)
+
+        return x_emb, e_emb, t_emb, max_length_emb
