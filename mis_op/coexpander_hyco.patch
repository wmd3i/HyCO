+# co_expander/model/encoder/prefix_encoder.py
+
+import torch
+import torch.nn as nn
+import torch.nn.utils.rnn as rnn_utils
+
+class PrefixEncoder(nn.Module):
+    """
+    Encodes a variable-length sequence of prefix node features using an LSTM
+    to produce a single conditioning vector.
+    """
+    def __init__(self, node_feat_dim, hidden_dim, output_dim):
+        super().__init__()
+        self.lstm = nn.LSTM(
+            input_size=node_feat_dim, 
+            hidden_size=hidden_dim, 
+            batch_first=True
+        )
+        self.linear = nn.Linear(hidden_dim, output_dim)
+
+    def forward(self, prefix_node_features, prefix_lengths):
+        """
+        Args:
+            prefix_node_features (Tensor): Padded tensor of prefix features (B, max_len, node_feat_dim).
+            prefix_lengths (Tensor): Tensor of original sequence lengths (B,).
+        """
+        # Pack padded sequence to handle variable lengths
+        packed_features = rnn_utils.pack_padded_sequence(
+            prefix_node_features,
+            prefix_lengths.cpu(), # pack_padded_sequence requires lengths on CPU
+            batch_first=True,
+            enforce_sorted=False
+        )
+        
+        # LSTM processing
+        self.lstm.flatten_parameters()
+        _, (hn, _) = self.lstm(packed_features)
+        
+        # Get the final hidden state and project it
+        return self.linear(hn.squeeze(0))
