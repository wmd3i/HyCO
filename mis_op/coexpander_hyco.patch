diff --git a/co_expander/model/decoder/decode/op.py b/co_expander/model/decoder/decode/op.py
new file mode 100644
index 0000000..cb2e0d5
--- /dev/null
+++ b/co_expander/model/decoder/decode/op.py
@@ -0,0 +1,141 @@
+# co_expander_edit/model/decoder/decode/op.py
+
+import torch
+import numpy as np
+from torch import Tensor
+from typing import Union, List, Dict, Tuple, Any
+from ml4co_kit import to_numpy, check_dim
+
+# --- OP metric computation (from evaluation_op100.py) ---
+def calculate_op_metrics(instance_locs: np.ndarray, tour: List[int], prizes: np.ndarray) -> Tuple[float, float]:
+    """Calculates the total prize and distance for an OP solution."""
+    if not tour: return 0.0, 0.0
+    full_tour_indices = [0] + tour + [0]
+    tour_locs = instance_locs[full_tour_indices]
+    tour_distances = np.sqrt(np.sum((tour_locs[:-1] - tour_locs[1:])**2, axis=1))
+    total_distance = np.sum(tour_distances).item()
+    total_prize = prizes[tour].sum().item()
+    return total_prize, total_distance
+
+# --- OP decoding function (from evaluation_op100.py, slightly modified) ---
+def decode_op_solution_from_heatmap(
+    adj_probs: np.ndarray, # Heatmap for edges in k-NN graph
+    edge_index: np.ndarray, # (2, E)
+    coords: np.ndarray,     # (N, 2)
+    prizes: np.ndarray,     # (N,)
+    max_length: float,
+    nodes_num: int
+) -> List[int]:
+    """Constructs an OP solution from a sparse heatmap using a guided greedy heuristic."""
+
+    # 1. Rebuild or approximate the dense probability matrix (optional but helpful for understanding)
+    #    A more efficient approach is to use the sparse adj_probs and edge_index directly
+    #    Here we emulate an adjacency list with a dict
+    adj_prob_dict = {}
+    for i in range(edge_index.shape[1]):
+        u, v = edge_index[0, i], edge_index[1, i]
+        prob = adj_probs[i]
+        adj_prob_dict.setdefault(u, {})[v] = prob
+        adj_prob_dict.setdefault(v, {})[u] = prob # Assume symmetry
+
+    # 2. Compute pairwise distances between all nodes
+    dists = np.linalg.norm(coords[:, np.newaxis, :] - coords[np.newaxis, :, :], axis=-1)
+
+    # 3. Greedy decoding
+    unvisited_customers = set(range(1, nodes_num))
+    tour = []
+    current_node = 0
+    current_length = 0.0
+
+    while unvisited_customers:
+        best_score = -float('inf')
+        best_next_node = -1
+
+        potential_next_nodes = list(unvisited_customers)
+        np.random.shuffle(potential_next_nodes) # Add randomness in tie-breaking
+
+        for next_node in potential_next_nodes:
+            # Check feasibility
+            potential_new_length = current_length + dists[current_node, next_node] + dists[next_node, 0]
+
+            if potential_new_length <= max_length:
+                # Get edge probability (handle missing edges in sparse graph)
+                prob = adj_prob_dict.get(current_node, {}).get(next_node, 0.0) # Default to 0 if edge not in kNN
+
+                # Score: prize * prob / distance
+                score = (prizes[next_node] * prob) / (dists[current_node, next_node] + 1e-6)
+
+                if score > best_score:
+                    best_score = score
+                    best_next_node = next_node
+
+        if best_next_node != -1:
+            tour.append(best_next_node)
+            current_length += dists[current_node, best_next_node]
+            current_node = best_next_node
+            unvisited_customers.remove(best_next_node)
+        else:
+            break # No feasible node found
+
+    return tour
+
+# --- Main decoding interface ---
+def op_sparse_decode(
+    vars: Tensor,           # (E_batch,) Predicted edge probabilities (heatmap)
+    nodes_feature: Tensor, # (V_batch, 3) IsDepot, Prize, IsPrefix
+    edge_index: Tensor,    # (2, E_batch)
+    nodes_num_list: list,
+    edges_num_list: list,
+    raw_data_list: list,   # List of (coords, prizes, max_length, ref_tour) tuples
+    return_cost: bool,
+    # --- Other parameters that may be needed (from *batch_data_dict) ---
+    task: str = None, x: Tensor = None, edges_feature: Tensor = None, e: Tensor = None,
+    graph_list: List[Tensor] = None, mask: Tensor = None, ground_truth: Tensor = None,
+    prefix_nodes: List[Tensor] = None, node_prefix_state: Tensor = None,
+    max_lengths: Tensor = None, # Batched max_lengths
+    # --- Decoder-specific parameters ---
+    use_ls: bool = False, # Placeholder for potential local search
+    **kwargs # Catch other decode_kwargs
+) -> Union[List[np.ndarray], np.floating]:
+
+    heatmap_np = to_numpy(vars)
+    edge_index_np = to_numpy(edge_index)
+
+    solutions = []
+    total_reward = 0.0
+    node_offset = 0
+    edge_offset = 0
+
+    for i in range(len(nodes_num_list)):
+        nodes_num = nodes_num_list[i]
+        edges_num = edges_num_list[i]
+
+        # Extract data for the current instance
+        instance_heatmap = heatmap_np[edge_offset : edge_offset + edges_num]
+        instance_edge_index = edge_index_np[:, edge_offset : edge_offset + edges_num] - node_offset
+        instance_coords, instance_prizes, instance_max_length, _ = raw_data_list[i] # Get from raw_data
+
+        # Decode the tour
+        decoded_tour = decode_op_solution_from_heatmap(
+            adj_probs=instance_heatmap,
+            edge_index=instance_edge_index,
+            coords=instance_coords,
+            prizes=instance_prizes,
+            max_length=instance_max_length,
+            nodes_num=nodes_num
+        )
+
+        solutions.append(np.array(decoded_tour, dtype=np.int64))
+
+        if return_cost:
+             reward, _ = calculate_op_metrics(instance_coords, decoded_tour, instance_prizes)
+             total_reward += reward
+
+        # Update offsets
+        node_offset += nodes_num
+        edge_offset += edges_num
+
+    if return_cost:
+        return total_reward / len(nodes_num_list) if nodes_num_list else 0.0
+    else:
+        return solutions
